--- a/components/esp_matter/data_model_provider/clusters/occupancy_sensing/integration.cpp
+++ b/components/esp_matter/data_model_provider/clusters/occupancy_sensing/integration.cpp
@@ -109,3 +109,26 @@
 {
 }
 
+
+// PATCH (esp-demo-matter): expose the registered cluster instance.
+//
+// The data model provider serves reads for a registered cluster from the cluster
+// object itself (esp_matter_data_model_provider.cpp: "if (auto *cluster =
+// mRegistry.Get(request.path)) return cluster->ReadAttribute(...)"), so the
+// Occupancy attribute lives in OccupancySensingCluster::mOccupancy. esp_matter's
+// attribute::update() writes a different store that is never read for this
+// cluster, which makes application writes silently no-op while returning ESP_OK.
+// Upstream acknowledges the gap in set_val(): "TODO: If not writable, we could
+// use the cluster-specific setter API to update the value".
+//
+// gServers is file-local, so this accessor is the minimum needed to reach the
+// real setter. See README.md for the plan to retire this patch.
+chip::app::Clusters::OccupancySensingCluster *
+esp_matter_get_occupancy_cluster(chip::EndpointId endpointId)
+{
+    auto it = gServers.find(endpointId);
+    if (it == gServers.end() || !it->second.IsConstructed()) {
+        return nullptr;
+    }
+    return &it->second.Cluster();
+}
